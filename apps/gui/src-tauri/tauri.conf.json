{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "usbkeeper",
  "mainBinaryName": "usbkeeper-gui",
  "version": "0.5.0",
  "identifier": "dev.usbkeeper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "usbkeeper", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Pendrives e HDs externos: falsificação, saúde, formatação",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
